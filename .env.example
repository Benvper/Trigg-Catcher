# ============================================================
# Weekly Lead Finder — environment variables
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; this example file is safe to commit.
#
# IMPORTANT: every key below must ALSO be added to the
# Trigger.dev dashboard (Project → Environment Variables) for
# both staging and prod before deploying. Missing dashboard
# vars are the #1 cause of production failures.
# ============================================================


# --- Business discovery (OpenStreetMap Overpass API) ----------
# No signup, no API key, no billing account — nothing to configure here.
# Both Google Places and Foursquare required a credit card to get past
# their sandbox tier, so discovery runs on OpenStreetMap's free public
# Overpass API instead. Trade-off: no ratings/review counts, and fewer
# small businesses have a website tagged, so some weeks may return fewer
# than LEADS_PER_WEEK leads.


# --- Hunter.io (email enrichment) ----------------------------
# Where to get it: hunter.io → sign up free → Dashboard → API
# Free plan = 25 domain searches/month. The automation reads your
# remaining credits from Hunter before each run and stops early
# rather than erroring when they run out.
HUNTER_API_KEY=

# Leave this many Hunter credits unspent as a buffer (default 0).
HUNTER_CREDIT_RESERVE=0


# --- Anthropic (pitch + email generation) --------------------
# Where to get it: console.anthropic.com → Settings → API keys
# Expect roughly $2-3/month at 10 leads per week.
ANTHROPIC_API_KEY=


# --- Resend (Monday digest email) ----------------------------
# Where to get it: resend.com → sign up free → API Keys → Create
# Free plan = 3,000 emails/month, far more than needed.
RESEND_API_KEY=

# The "from" address. Until you verify your own domain in Resend,
# use onboarding@resend.dev — it works immediately but can only
# send to the email address you signed up with.
DIGEST_FROM_EMAIL=onboarding@resend.dev

# Where the Monday digest lands.
DIGEST_TO_EMAIL=


# --- Lead targeting ------------------------------------------
# How many leads to aim for each Monday.
LEADS_PER_WEEK=5

# Comma-separated. Options: professional, home_services, healthcare, retail
TARGET_VERTICALS=professional,home_services,healthcare,retail


# --- Your details (used to write and sign the outreach email) -
# Fill in your real name below — the email signs off with your name and
# "AI automator" only. No company name is invented or used.
SENDER_NAME=
SENDER_TITLE=AI automator
SENDER_COMPANY=
SENDER_EMAIL=
SENDER_PHONE=

# A booking link (Calendly, Cal.com, Google Calendar appointments).
# Leave blank and the email will ask them to reply with times instead.
SENDER_CALENDAR_URL=

# Path to your resume file, for your own reference. The drafted email
# mentions that your resume is attached — you attach the actual file
# yourself when you send it, since this automation only drafts emails
# and never sends them on your behalf.
RESUME_PATH=


# --- Your offer and guarantee --------------------------------
# These go into EVERY email exactly as written. Decide the terms
# once, here, so the same promise goes out every time.

# The minimum hours you promise to save them.
GUARANTEE_HOURS=10

# The period those hours are measured over: "per week" or "per month".
GUARANTEE_PERIOD=per week

# The exact guarantee sentence. Make it specific and measurable —
# a vague guarantee is the thing prospects push back on.
GUARANTEE_TERMS=If the automation I build doesn't save you at least 10 hours per week within 30 days of going live, I refund your payment in full.
